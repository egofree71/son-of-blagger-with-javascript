{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/main.ts",
    "src/scenes/**/*.ts",
    "src/entities/**/*.ts",
    "src/tiled/**/*.ts",
    "src/state/**/*.ts",
    "src/ui/**/*.ts"
  ]
}
